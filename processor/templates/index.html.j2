<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { color-scheme: light; }
  body { margin: 0; padding: 24px 16px 48px; background: #f9f9f7; color: #0b0b0b;
         font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 15px; line-height: 1.5; }
  main { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; }
  h2 { font-size: 1.2rem; margin: 40px 0 10px; padding-top: 8px; border-top: 1px solid #e1e0d9; }
  h3 { font-size: 1rem; margin: 22px 0 6px; }
  h4 { font-size: 0.95rem; margin: 14px 0 4px; color: #52514e; }
  .sub { color: #52514e; margin: 0 0 14px; }
  .muted { color: #898781; }
  nav { font-size: 14px; margin: 10px 0 18px; }
  nav a { margin-right: 14px; white-space: nowrap; }
  .card { background: #fcfcfb; border: 1px solid rgba(11,11,11,0.10); border-radius: 8px; padding: 12px 16px; margin: 12px 0; }
  ul.obs { margin: 6px 0; padding-left: 20px; } ul.obs li { margin: 3px 0; }
  .caveats { background: #fff7df; border: 1px solid #fab219; border-radius: 6px; padding: 8px 12px; font-size: 14px; margin: 10px 0; }
  .caveats strong { display: block; margin-bottom: 2px; }
  .caveats ul { margin: 4px 0; padding-left: 20px; }
  .error { background: #fbe3e3; border: 1px solid #d03b3b; border-radius: 6px; padding: 8px 12px; font-size: 14px; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid #e1e0d9; vertical-align: top; }
  th { color: #52514e; font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wrap { overflow-x: auto; }
  .flag { display: inline-block; padding: 0 7px; border-radius: 10px; font-size: 12px; white-space: nowrap;
          background: #fbe3e3; color: #7a1f1f; border: 1px solid #d03b3b; margin: 1px 0; }
  .up { color: #a33b13; } .down { color: #1c5cab; }
  figure { margin: 14px 0; }
  figure img { max-width: 100%; height: auto; display: block; background: #fff; border: 1px solid #e1e0d9; border-radius: 6px; }
  figcaption { color: #52514e; font-size: 13px; margin-top: 4px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
  .small { font-size: 12.5px; }
  details summary { cursor: pointer; color: #1c5cab; }
  code { font-size: 12.5px; background: #f0efec; padding: 0 3px; border-radius: 3px; word-break: break-word; }
  a { color: #1c5cab; }
  ol.refs li { margin: 3px 0; }
  footer { margin-top: 40px; color: #898781; font-size: 13px; }
</style>
</head>
<body>
<main>
<h1>{{ title }}</h1>
<p class="sub">
  {% if runs %}{{ runs | length }} comparison{{ "s" if runs | length != 1 }} ({% for r in runs %}{{ r.formula }}{{ ", " if not loop.last }}{% endfor %}). {% endif %}
  Generated {{ generated_at }}. Research use; observations describe the data and are not clinical findings.
</p>
<nav>
  {% if runs %}<a href="#design">Design</a>{% endif %}
  {% if qc %}<a href="#qc">Sample QC</a>{% endif %}
  {% for r in runs %}<a href="#de-{{ loop.index }}">Differential expression{% if runs | length > 1 %}: {{ r.label }}{% endif %}</a>{% endfor %}
  <a href="#methods">Methods</a>
  <a href="#citations">Citations</a>
  <a href="#data">Data</a>
</nav>

{% macro observations(items) %}
{% if items %}<ul class="obs">{% for o in items %}<li>{{ o }}</li>{% endfor %}</ul>{% endif %}
{% endmacro %}
{% macro caveats(items) %}
{% if items %}<div class="caveats"><strong>Keep in mind</strong><ul>{% for c in items %}<li>{{ c }}</li>{% endfor %}</ul></div>{% endif %}
{% endmacro %}
{% macro figure(uri, cap) %}
{% if uri %}<figure><img src="{{ uri }}" alt="{{ cap }}"><figcaption>{{ cap }}</figcaption></figure>{% endif %}
{% endmacro %}

{% if errors %}
<div class="error"><strong>Some sections could not be rendered</strong>:
<ul>{% for e in errors %}<li>{{ e.section }}: {{ e.error }}</li>{% endfor %}</ul></div>
{% endif %}

{# ------------------------------------------------------------------ design #}
{% if runs %}
<h2 id="design">Design</h2>
{% for r in runs %}
<div class="card">
<h3>{{ r.label }}: <code>{{ r.formula }}</code></h3>
<p class="small">Counts: {{ r.layout }}; organism {{ r.organism }}; {{ r.genes.tested | num }} of {{ r.genes.input | num }} genes tested.
Reference levels: {% for k, v in r.reference_levels.items() %}{{ k }} = {{ v }}{{ "; " if not loop.last }}{% endfor %}.</p>
<details{% if r.samples | length <= 24 %} open{% endif %}><summary>{{ r.samples | length }} samples</summary>
<div class="wrap"><table>
<tr><th>sample</th>{% for t in r.terms %}<th>{{ t }}</th>{% endfor %}</tr>
{% for s in r.samples %}<tr><td>{{ s.sample_id }}</td>{% for t in r.terms %}<td>{{ s[t] }}</td>{% endfor %}</tr>{% endfor %}
</table></div></details>
{% if r.left_out %}<p class="small">Left out: {% for s in r.left_out %}{{ s.sample_id }} ({{ s.reason }}){{ "; " if not loop.last }}{% endfor %}.</p>{% endif %}
{% if r.notes %}<details><summary>Notes from bulk-de ({{ r.notes | length }})</summary><ul class="small">{% for n in r.notes %}<li>{{ n }}</li>{% endfor %}</ul></details>{% endif %}
</div>
{% endfor %}
{% endif %}

{# ------------------------------------------------------------------ QC #}
{% if qc %}
<h2 id="qc">Sample QC</h2>
{{ observations(qc.observations) }}
{{ caveats(qc.caveats) }}
{{ figure(qc_png, ("Reads after trimming and salmon mapping rate" if qc.source == "quant" else "Counts and genes detected") ~ " per library; red = flagged.") }}
<div class="wrap"><table>
{% if qc.source == "quant" %}
<tr><th>sample</th><th>layout</th><th class="num">reads</th><th class="num">after trimming</th><th class="num">retained</th><th class="num">mapping rate</th>{% if qc.has_q30 %}<th class="num">Q30</th><th class="num">GC</th>{% endif %}<th>flags</th></tr>
{% for r in qc.rows %}<tr><td>{{ r.sample_id }}</td><td>{{ r.layout }}</td><td class="num">{{ r.reads_in | num }}</td><td class="num">{{ r.reads_after_trim | num }}</td><td class="num">{{ r.retained | pct }}</td><td class="num">{{ r.mapping_rate | pct }}</td>{% if qc.has_q30 %}<td class="num">{{ r.q30 | pct }}</td><td class="num">{{ r.gc | pct }}</td>{% endif %}<td>{% for f in r.flags %}<span class="flag">{{ f }}</span> {% endfor %}</td></tr>{% endfor %}
{% else %}
<tr><th>sample</th><th class="num">counts</th><th class="num">genes detected</th><th class="num">size factor</th><th>used</th><th>flags</th></tr>
{% for r in qc.rows %}<tr><td>{{ r.sample_id }}</td><td class="num">{{ r.library_size | num }}</td><td class="num">{{ r.n_genes_detected | num }}</td><td class="num">{{ r.size_factor | num(3) }}</td><td>{{ "yes" if r.used else "no" }}</td><td>{% for f in r.flags %}<span class="flag">{{ f }}</span> {% endfor %}</td></tr>{% endfor %}
{% endif %}
</table></div>
{% endif %}

{# ------------------------------------------------------------------ DE #}
{% for r in runs %}
<h2 id="de-{{ loop.index }}">Differential expression{% if runs | length > 1 %}: {{ r.label }}{% endif %}</h2>
{{ observations(r.observations) }}
{{ caveats(r.caveats) }}
{{ figure(r.pca_png | img, "PCA of the variance-stabilised counts of the 500 most variable genes (blind to the design).") }}
{% for c in r.contrasts %}
<h3>{{ c.column }}: {{ c.level }} vs {{ c.reference }}</h3>
<p>{{ c.observation }}</p>
<div class="grid">
{{ figure(c.volcano | img, "Volcano: log2 fold change vs -log10 p; coloured at FDR " ~ fdr ~ ", top genes named.") }}
{{ figure(c.ma | img, "MA: " ~ ("shrunk " if c.lfc_shrunk else "") ~ "log2 fold change vs mean normalised count.") }}
</div>
{% for side, rows in (("Up in " ~ c.level, c.up), ("Down in " ~ c.level, c.down)) %}
{% if rows %}
<h4>{{ side }} (top {{ rows | length }} by adjusted p)</h4>
<div class="wrap"><table>
<tr><th>gene</th><th>id</th><th class="num">mean count</th><th class="num">log2 FC{% if c.lfc_column == "log2_fold_change_shrunk" %} (shrunk){% endif %}</th><th class="num">adj. p</th></tr>
{% for g in rows %}<tr><td>{{ g.gene_name }}</td><td class="small">{{ g.gene_id }}</td><td class="num">{{ g.base_mean | num }}</td><td class="num {{ 'up' if g.lfc > 0 else 'down' }}">{{ g.lfc | num(2) }}</td><td class="num">{{ g.padj | pval }}</td></tr>{% endfor %}
</table></div>
{% endif %}
{% endfor %}
{% if c.gsea %}
<h4>Gene set enrichment (preranked GSEA)</h4>
{{ observations(c.gsea_observations) }}
{% for g in c.gsea %}
<details{% if g.n_significant %} open{% endif %}><summary>{{ g.collection }}: {{ g.n_up }} up, {{ g.n_down }} down of {{ g.n_sets }} sets at FDR {{ fdr }}</summary>
<div class="wrap"><table>
<tr><th>gene set</th><th class="num">size</th><th class="num">NES</th><th class="num">FDR</th><th>leading edge</th></tr>
{% for x in g.up + g.down %}<tr><td>{{ x.term }}</td><td class="num">{{ x.size }}</td><td class="num {{ 'up' if x.nes > 0 else 'down' }}">{{ x.nes | num(2) }}</td><td class="num">{{ x.fdr | pval }}</td><td class="small">{{ (x.leading_edge or "").split(";")[:8] | join(", ") }}</td></tr>{% endfor %}
</table></div></details>
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}

{# ------------------------------------------------------------------ methods #}
<h2 id="methods">Methods</h2>
<p class="small">Each step as its provenance.json records it; numbers refer to the citations below.</p>
<div class="wrap"><table>
<tr><th>step</th><th>version</th><th>parameters</th><th>tools</th><th>cites</th></tr>
{% for s in methods.steps %}<tr><td>{{ s.app }}<br><span class="small muted">{{ s.where }}</span></td><td>{{ s.version }}</td><td class="small"><code>{{ s.parameters }}</code></td><td class="small">{{ s.tools }}</td><td>{{ s.citations | join(", ") }}</td></tr>{% endfor %}
</table></div>

<h2 id="citations">Citations</h2>
<ol class="refs small">
{% for r in methods.references %}<li>{{ r.text }}{% if r.doi %} <a href="https://doi.org/{{ r.doi }}">doi:{{ r.doi }}</a>{% endif %}{% if r.pmid %} PMID {{ r.pmid }}{% endif %}</li>{% endfor %}
</ol>

<h2 id="data">Data</h2>
{% if credit %}
<ul class="small">{% for d in credit %}<li>{{ d.text }}{% if d.doi %} <a href="https://doi.org/{{ d.doi }}">doi:{{ d.doi }}</a>{% endif %}{% if d.licence %} ({{ d.licence }}){% endif %}{% if d.paper %}. Described in: {{ d.paper }}{% endif %}</li>{% endfor %}</ul>
{% else %}
<p class="small muted">No dataset credit given (set DATA_CREDIT to name the dataset, its authors, DOI and licence).</p>
{% endif %}
<footer>bulk-report {{ methods.steps[-1].version }} · Pennsieve (University of Pennsylvania)</footer>
</main>
</body>
</html>
